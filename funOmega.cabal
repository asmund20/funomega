cabal-version:      3.0
name:               funOmega
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             Student
category:           Language
build-type:         Simple

library
    exposed-modules:  Syntax, Parser, TypeChecker, Interpreter
    build-depends:    base, parsec
    hs-source-dirs:   implementation
    default-language: Haskell2010

executable funOmega
    other-modules:    Editor
    main-is:          Driver.hs
    hs-source-dirs:   application
    default-language: Haskell2010
    build-depends:
        base
      , funOmega
      , free

test-suite funOmega-test
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base
      , funOmega
      , tasty
      , tasty-hunit
      , tasty-quickcheck
