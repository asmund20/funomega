cabal-version:      3.0
name:               funOmega
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             Student
category:           Language
build-type:         Simple

library
    exposed-modules:  Syntax, Parser, TypeChecker, Interpreter
    build-depends:    containers ^>=0.8, base, parsec
    hs-source-dirs:   implementation
    default-language: Haskell2010
    ghc-options:      -Wall -Wincomplete-uni-patterns

executable funOmega
    other-modules:    Editor
    main-is:          Driver.hs
    hs-source-dirs:   application
    default-language: Haskell2010
    build-depends:
        directory ^>=1.3.8.5
      , containers ^>=0.8
      , mtl ^>=2.3.1
      , base
      , funOmega
      , free
    ghc-options:      -Wall -Wincomplete-uni-patterns

test-suite funOmega-test
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    Fib, ParserTests
    build-depends:
        QuickCheck ^>=2.18.0.0
      , base
      , funOmega
      , tasty
      , tasty-hunit
      , tasty-quickcheck
    ghc-options:      -Wall -Wincomplete-uni-patterns
